# i. Install and load the MASS package
if (!require(MASS)) install.packages("MASS")
library(MASS)
# Start diverting output to a text file
sink("cats_output.txt")
# ii. Load the cats dataset
data(cats)
# iii. List all the variables of the data cats
cat("=== Variables in cats dataset ===\n")
names(cats)
cat("\n=================================\n\n")
# iv. Create a new dataset with the log-transformed 'Bwt' variable
cats_new <- transform(cats, log_Bwt = log(Bwt))
# v. Print out the data
cat("=== Updated Dataset with Log-Transformed Bwt ===\n")
print(cats_new)
# Stop the sink and save the file safely
sink()

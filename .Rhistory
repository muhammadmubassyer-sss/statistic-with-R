names(scores) <- best
vec <- c(1,2)
# 1. Create a numeric vector of test scores
scores <- c(88, 95, 72, 91)
# 2. Create a character vector of student names
names <- c("Alice", "Deepa", "Charlie", "David")
# 3. Assign the names as attributes to the score elements
names(scores) <- names
# 4. View the entire named vector
scores
# Output:
#   Alice   Deepa Charlie   David
#      88      95      72      91
# 5. Access a single score using the name label
scores["Deepa"]
# Output:
# Deepa
#    95
vec <- 1:20
result <- numeric(length(vec))
for (i in 1:length(vec)) {
mult <- vec[i] * 3
if (mult %% 2 == 0) {
result[i] <- mult / 2
} else {
result[i] <- mult
}
}
print(result)
multiples <- (1:15) * 4
for (val in multiples) {
if (val < 20) {
print(paste(val, "- Below 20"))
} else {
print(paste(val, "- Above 20"))
}
}
fib <- numeric(100)
fib[1] <- 1
fib[2] <- 1
for (i in 3:100) {
fib[i] <- fib[i - 1] + fib[i - 2]
}
print(fib)
set.seed(42)
# Define the number of rolls
n <- 10000
# Simulate rolling the first die 10,000 times
# The numbers 1:6 represent the die faces. We MUST use replace = TRUE.
die1 <- sample(1:6, size = n, replace = TRUE)
# Simulate rolling the second die 10,000 times
die2 <- sample(1:6, size = n, replace = TRUE)
# Combine the results into a data frame
dice_rolls <- data.frame(
Roll_Number = 1:n,
Die_1 = die1,
Die_2 = die2,
Total = die1 + die2
)
set.seed(42)
# Define the number of rolls
n <- 10000
# Simulate rolling the first die 10,000 times
# The numbers 1:6 represent the die faces. We MUST use replace = TRUE.
die1 <- sample(1:6, size = n, replace = TRUE)
# Simulate rolling the second die 10,000 times
die2 <- sample(1:6, size = n, replace = TRUE)
# Combine the results into a data frame
dice_rolls <- data.frame(
Roll_Number = 1:n,
Die_1 = die1,
Die_2 = die2,
Total = die1 + die2
)
# Calculate the empirical probability of rolling exactly a 9
empirical_prob_9 <- mean(dice_rolls$Total == 9)
# Print the result
print(empirical_prob_9)
tech = c("Alice", "Bob", "Charlie", "David", "Eve")
company_data = data.frame("Tech" = tech)
design = c("Frank", "Grace", "Heidi", "Ivan", "Judy")
cbind(company_data, "Design" = design)
# 2-person party planning duo consisting of exactly one Tech employee and one Design sample(tech, 1)
sample(design, 1)
# two names from the Design column without replacement.
sample(design, 2)
# ignore the departments entirely and select 4
sample(c(tech, design), 4)

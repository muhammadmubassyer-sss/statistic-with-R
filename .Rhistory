# RUN THIS BLOCK FIRST TO PREPARE THE DATASETS
set.seed(3433)
# Dataset 1: Logistics & Fleet Performance
fleet_data <- data.frame(
Truck_ID = 101:200,
Region = sample(c("North", "Central", "South"), 100, replace = TRUE),
Fuel_Efficiency = c(rnorm(95, mean = 8.5, sd = 1.2), c(18.2, 19.5, 2.1, 1.8, 22.0)), # Contains outliers
Maintenance_Cost = round(runif(100, 500, 5000), 2),
Engine_Type = sample(c("Diesel", "Hybrid", "EV"), 100, replace = TRUE, prob = c(0.5, 0.3, 0.2))
)
fleet_data$Fuel_Efficiency[sample(1:100, 8)] <- NA
# Dataset 2: Operational Downtime Tracker
downtime_data <- data.frame(
Machine_ID = paste0("M-", 1:120),
Shift = factor(sample(c("Morning", "Afternoon", "Night"), 120, replace = TRUE)),
Downtime_Mins = rpois(120, lambda = 45),
Failure_Mode = sample(c("Mechanical", "Electrical", "Operator Error", "Software"), 120, replace = TRUE, prob = c(0.4, 0.3, 0.2, 0.1))
)
# Base R aggregation
summary_table <- aggregate(Maintenance_Cost ~ Region, data = fleet_data,
FUN = function(x) c(mean = mean(x),
sd = sd(x),
n = length(x)))
# Flatten matrix column into a standard data frame
summary_table <- do.call(data.frame, summary_table)
colnames(summary_table) <- c("Region", "Mean_Cost", "SD_Cost", "Sample_Count")
print(summary_table)
# Multi-variable aggregate split simultaneously by Region and Engine_Type
multi_agg <- aggregate(cbind(Maintenance_Cost, Fuel_Efficiency) ~ Region + Engine_Type,
data = fleet_data,
FUN = mean,
na.rm = TRUE)
print(multi_agg)
# Base R Parallel Boxplot
boxplot(Maintenance_Cost ~ Engine_Type,
data = fleet_data,
col = c("#377eb8", "#4daf4a", "#ff7f00"), # Unique colors: Diesel (Blue), EV (Green), Hybrid (Orange)
main = "Fleet Maintenance Cost by Engine Type",
xlab = "Engine Configuration",
ylab = "Maintenance Cost ($)",
border = "darkslategrey",
las = 1,          # Makes y-axis labels horizontal
cex.main = 1.2,   # Main title scaling
cex.lab = 1.0)    # Axis label scaling
dev.off()
# 2c.
# Base R Parallel Boxplot
boxplot(Maintenance_Cost ~ Engine_Type,
data = fleet_data,
col = c("#377eb8", "#4daf4a", "#ff7f00"), # Unique colors: Diesel (Blue), EV (Green), Hybrid (Orange)
main = "Fleet Maintenance Cost by Engine Type",
xlab = "Engine Configuration",
ylab = "Maintenance Cost ($)",
border = "darkslategrey",
las = 1,          # Makes y-axis labels horizontal
cex.main = 1.2,   # Main title scaling
cex.lab = 1.0)    # Axis label scaling
# Optional: Add gridlines for improved readability
grid(nx = NA, ny = NULL, col = "lightgray", lty = "dotted")
